# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- 密钥：绝对不要提交 ----
.env
.env.*
# 但配置模板必须入库，否则组员不知道要填哪些字段
!.env.example
*.key
secrets.json

# ---- 运行产物（每次跑都会重新生成）----
reports/sessions/
reports/uploads/
reports/frames/
reports/smoke/
reports/video_test/
# 长时序适配实验的产物（4 分钟视频 + 64 张抽帧图，体积大且可复现，不入库）
reports/long_video_test/
reports/tools/
reports/tool_calls.jsonl
reports/*_report.json
reports/*_report.md
# 实验过程目录：试跑、占位数据、中途结果都在这，默认不入库。
# 最终的正式三组对比结果请用 `git add -f reports/experiments/comparison.*` 显式提交，
# 避免中途的无效数字被误当成实验结论。
reports/experiments*/
reports/api_test/

# ---- 占位演示数据（由脚本生成，不是真实实验数据）----
data/demo/
data/demo_video/
data/demo_labels_*.csv

# ---- 公开数据集：图片不入库（第三方数据，可用 scripts/fetch_lab_dataset.py 重新拉取）
# 但标注 CSV（data/lab_labels_*.csv）要入库——那是我们的标注成果
data/lab/
.cache/

# ---- 网络图库素材（Pexels 等）----
# 规则：**数据集实际用到的 35 张真实照片已强制入库**（git add -f），
# 这样别人 clone 下来就能直接跑实验，不需要重新采集。
# 其余未入选的候选图（73 张）不入库，需要时用 scripts/fetch_web_images.py 重采。
# 注意：被这条规则命中的文件，若要用必须 git add -f 显式加入。
data/web_raw/*.jpg
!data/web_raw/manifest.json

# ---- 合成样本的原始 PNG 备份不入库（体积大，JPEG 版本已入库）----
data/synth/_original_png/

# ---- 标注辅助图：接触印相表（由 scripts/make_contact_sheet.py 重新生成）----
reports/sheets/

# ---- 自拍素材与导入产物 ----
# inbox 是手机的原始拷贝（含 GPS 等元数据，绝不能传）；raw 是归一化后的图。
# 两者都可由 scripts/ingest_photos.py 重新生成。
data/inbox/
data/raw/
data/labels_draft.csv
data/ingest_report.json

# ---- 实验输出 ----
# 默认忽略（往往是占位数据跑出来的）。
# 用真实数据跑出结果后，请显式加入：git add -f reports/experiments
reports/experiments/

# ---- 例外：保留仓库自带的示例报告 ----
!reports/ppe_example_report.json
!reports/ppe_example_report.md

# 标注修正时生成的备份（fix_labels.py 产生，可随时从 CSV 重新导出）
data/*.csv.bak
