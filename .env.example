# 复制本文件为 .env 后填入真实值。.env 已被 .gitignore 排除，不会进版本库。
#
#   cp .env.example .env
#
# 只要第 1 行填了 Key，系统就会从模拟模式切到真实识别模式，
# 用 `python src/main.py status` 可以确认当前是 api 还是 mock。

# ---------- 必填：多模态模型 ----------
# 智谱（推荐）：https://open.bigmodel.cn/usercenter/proj-mgmt/apikeys
# 形如 32位十六进制.16位字符
SAFETY_LLM_API_KEY=

# ---------- 以下按平台选择，默认值即智谱 ----------
# 智谱 GLM-4V-Flash 是永久免费模型，本项目用量下不花钱
SAFETY_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
SAFETY_LLM_MODEL=glm-4v-flash

# 图片传给模型的方式：
#   data_uri —— OpenAI / 通义 等，形如 data:image/jpeg;base64,xxxx（默认）
#   base64   —— 智谱，只接受裸 base64，不能带前缀
#   url      —— 部分平台只接受公网图片地址（本项目的本地文件用不了）
SAFETY_LLM_IMAGE_FORMAT=base64

# 单次请求超时（秒）
SAFETY_LLM_TIMEOUT=90
